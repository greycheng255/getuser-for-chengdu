# MySQL Configuration
MYSQL_DB_PWD=123456
MYSQL_DB_USER=root
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=media_crawler

# Redis Configuration
REDIS_DB_HOST=127.0.0.1
REDIS_DB_PWD=123456
REDIS_DB_PORT=6379
REDIS_DB_NUM=0

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PWD=
MONGODB_DB_NAME=media_crawler

# PostgreSQL Configuration
POSTGRES_DB_PWD=123456
POSTGRES_DB_USER=postgres
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=media_crawler

# Proxy Configuration (Wandou HTTP)
# your_wandou_http_app_key
WANDOU_APP_KEY=

# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=

# Carbon-Silicon Platform Agent Configuration
# 碳硅交易平台地址（留空则不自动注册）
CARBON_SILICON_PLATFORM_URL=
# 碳硅平台 MCP Server 地址
CARBON_SILICON_MCP_URL=
# 碳硅平台 API Token
CARBON_SILICON_API_TOKEN=
# Agent ID（唯一标识）
MEDIACRAWLER_AGENT_ID=agent-mediacrawler-001
# Agent 版本
MEDIACRAWLER_AGENT_VERSION=1.0.0
# Agent 对外暴露的基础URL（用于平台回调）
AGENT_BASE_URL=http://localhost:35092

# AI6700 API（暂时复用 ONELLM_* 变量，统一用于视频拆解、AI 回复和视频生成）
# 在 https://jly.lingkeai.vip 创建 API Key；服务端统一使用 Bearer Token。
ONELLM_API_KEY=
ONELLM_BASE_URL=https://api.lk888.ai/api
ONELLM_CHAT_MODEL=gpt-5.5
ONELLM_VIDEO_MODEL=kwvideo-v2
ONELLM_REFERENCE_VIDEO_MODEL=kwvideo-v2-ref

# 可选的 OpenNotebook OAuth 集成（不参与上述 AI/视频调用）
# OpenNotebook API/issuer 根 URL；本机 HTTP 可用，非本机必须使用 HTTPS。
OPENNOTEBOOK_URL=http://localhost:8000
# 在 OpenNotebook 注册的 OAuth Client UUID / Secret。
# 未配置 Secret 时自动按 Public Client 使用 PKCE。
OPENNOTEBOOK_CLIENT_ID=
OPENNOTEBOOK_CLIENT_SECRET=
# Fernet key；可用 `uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'` 生成
OPENNOTEBOOK_CREDENTIAL_ENCRYPTION_KEY=
# 可选：授权账号有多个工作区时优先选择此 ID，否则取最新工作区。
DEFAULT_WORKSPACE_ID=
# OAuth 回调默认由 AGENT_BASE_URL 推导；仅当前后端或前端使用不同公网域名时覆盖：
# MEDIACRAWLER_API_URL=https://api.mediacrawler.example
# MEDIACRAWLER_PUBLIC_URL=https://mediacrawler.example
# 旧版 OPENNOTEBOOK_* URL 和回调变量仍兼容。
# Agent 联系邮箱
AGENT_CONTACT_EMAIL=

# 统一账号迁移与兼容开关
# 写开关开启后，旧发布/机器人账号 API 只写 unified_accounts，禁止双写旧表。
UNIFIED_ACCOUNT_WRITE_ENABLED=false
# 紧急回滚时可临时设为 false，业务读取恢复到旧表。
UNIFIED_ACCOUNT_READ_ENABLED=false
# 兼容期保留旧路由；前端切换完成并确认无调用后再关闭。
LEGACY_ACCOUNT_API_ENABLED=true

# 统一话术库：开启后 X/Twitter 等调用方不再读取独立评论模板。
UNIFIED_SCRIPT_LIBRARY_ENABLED=false
DOUYIN_VIDEO_PUBLISH_ENABLED=false
XIAOHONGSHU_VIDEO_PUBLISH_ENABLED=false
CRAWLER_COOKIES=

# Apollo 运行时配置。Portal 地址不能替代 Meta/Config Service 地址。
APOLLO_ENABLED=false
APOLLO_META_SERVER_URL=
APOLLO_CONFIG_SERVER_URL=
APOLLO_APP_ID=getuser-for-chengdu
APOLLO_ENV=LOCAL
APOLLO_CLUSTER=dev
APOLLO_NAMESPACE=application
APOLLO_TIMEOUT_SECONDS=3
APOLLO_OVERRIDE_ENV=true
APOLLO_REQUIRED=false
